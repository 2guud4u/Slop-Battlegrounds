# Copy to .env and fill in. Real env vars take precedence.
# LLM judge + narrator — https://console.groq.com/keys (free tier)
GROQ_API_KEY=

# Champion/fight image gen — https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=

# Optional: Cloudflare Workers AI image gen instead of Gemini
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

# Optional
# ADDR=:8080
# GEN_DIR=./gen

# Pollinations gen API — https://gen.pollinations.ai (default image provider)
POLLINATION_API_KEY=
